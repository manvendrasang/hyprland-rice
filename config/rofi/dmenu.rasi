* {
	glass-bg:      rgba(18, 22, 32, 0.35);
	glass-panel:   rgba(255, 255, 255, 0.07);
	glass-border:  rgba(255, 255, 255, 0.18);
	accent:        #7dd3fc;
	accent-soft:   rgba(125, 211, 252, 0.28);
	text-main:     #f1f5f9;
	text-dim:      #cbd5e1;

	background-color: transparent;
	text-color: @text-main;
}

window {
	background-color: @glass-bg;
	border: 1px;
	border-color: @glass-border;
	border-radius: 22px;
	padding: 16px;
	width: 480px;
	location: center;
}

mainbox {
	background-color: transparent;
	spacing: 12px;
	children: [ "inputbar", "listview" ];
}

inputbar {
	background-color: @glass-panel;
	border: 1px;
	border-color: @glass-border;
	border-radius: 999px;
	padding: 8px 16px;
	children: [ "prompt", "entry" ];
}

prompt {
	background-color: transparent;
	text-color: @accent;
	border-radius: 999px;
	padding: 6px 16px;
	font: "JetBrainsMono Nerd Font Bold 11";
}

entry {
	background-color: transparent;
	text-color: @text-main;
	placeholder-color: #f1f5f988;
	padding: 6px 12px;
}

/* fixed-height + scrollbar so lists longer than the visible window
   are still reachable, instead of silently growing off-screen */
listview {
	background-color: transparent;
	columns: 1;
	lines: 8;
	spacing: 6px;
	fixed-height: true;
	cycle: true;
	scrollbar: true;
}

scrollbar {
	background-color: @glass-panel;
	handle-color: @accent-soft;
	handle-width: 6px;
	border-radius: 999px;
	padding: 0px 4px;
}

element {
	background-color: @glass-panel;
	border: 1px;
	border-color: transparent;
	border-radius: 14px;
	padding: 10px 14px;
	orientation: horizontal;
}

element-text {
	text-color: @text-dim;
	vertical-align: 0.5;
}

element selected {
	background-color: @accent-soft;
	border-color: @glass-border;
}

element selected element-text {
	text-color: @text-main;
}
