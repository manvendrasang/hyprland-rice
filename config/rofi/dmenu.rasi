/* See config.rasi for notes on what does/doesn't translate from the
   original web CSS recipe into rasi. Same palette, list layout. */

* {
	glass-bg:        rgba(255, 255, 255, 0.08);
	glass-panel:     rgba(255, 255, 255, 0.4);
	glass-border:    rgba(255, 255, 255, 0.3);
	glass-highlight: rgba(255, 255, 255, 0.8);
	text-main:       #1a1a1a;
	text-dim:        #1a1a1a99;

	background-color: transparent;
	text-color: @text-main;
}

window {
	background-color: @glass-bg;
	border: 2px;
	border-color: @glass-highlight;
	border-radius: 22px;
	padding: 16px;
	width: 480px;
	location: center;
}

mainbox {
	background-color: transparent;
	spacing: 12px;
	children: [ "inputbar", "listview" ];
}

inputbar {
	background-color: @glass-panel;
	border: 1px;
	border-color: @glass-border;
	border-radius: 999px;
	padding: 8px 16px;
	children: [ "prompt", "entry" ];
}

prompt {
	background-color: transparent;
	text-color: @text-main;
	border-radius: 999px;
	padding: 6px 16px;
	font: "JetBrainsMono Nerd Font Bold 11";
}

entry {
	background-color: transparent;
	text-color: @text-main;
	placeholder-color: @text-dim;
	padding: 6px 12px;
}

listview {
	background-color: transparent;
	columns: 1;
	lines: 8;
	spacing: 6px;
	fixed-height: true;
	cycle: true;
	scrollbar: true;
}

scrollbar {
	background-color: @glass-panel;
	handle-color: rgba(255, 255, 255, 0.6);
	handle-width: 6px;
	border-radius: 999px;
	padding: 0px 4px;
}

element {
	background-color: @glass-panel;
	border: 2px;
	border-color: @glass-highlight;
	border-radius: 14px;
	padding: 10px 14px;
	orientation: horizontal;
}

element-text {
	text-color: @text-main;
	vertical-align: 0.5;
}

element selected {
	background-color: rgba(255, 255, 255, 0.55);
	border-color: @glass-highlight;
}

element selected element-text {
	text-color: @text-main;
}
