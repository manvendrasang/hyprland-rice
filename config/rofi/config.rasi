configuration {
	modi: "drun,run,filebrowser";
	show-icons: true;
	icon-theme: "Papirus-Dark";
	drun-display-format: "{name}";
	display-drun: " Applications";
	display-run: " Run";
	display-filebrowser: " Files";
	font: "JetBrainsMono Nerd Font 11";
}

* {
	glass-bg:      rgba(18, 22, 32, 0.35);
	glass-panel:   rgba(255, 255, 255, 0.07);
	glass-border:  rgba(255, 255, 255, 0.18);
	accent:        #7dd3fc;
	accent-soft:   rgba(125, 211, 252, 0.28);
	text-main:     #f1f5f9;
	text-dim:      #cbd5e1;

	background-color: transparent;
	text-color: @text-main;
}

window {
	background-color: @glass-bg;
	border: 1px;
	border-color: @glass-border;
	border-radius: 24px;
	padding: 20px;
	width: 720px;
	location: center;
}

mainbox {
	background-color: transparent;
	spacing: 16px;
	children: [ "inputbar", "listview" ];
}

inputbar {
	background-color: @glass-panel;
	border: 1px;
	border-color: @glass-border;
	border-radius: 999px;
	padding: 10px 12px;
	spacing: 10px;
	children: [ "prompt", "entry" ];
}

prompt {
	background-color: transparent;
	text-color: @accent;
	border-radius: 999px;
	padding: 6px 16px;
	font: "JetBrainsMono Nerd Font Bold 11";
}

entry {
	background-color: transparent;
	text-color: @text-main;
	placeholder: "Search...";
	placeholder-color: #f1f5f988;
	padding: 6px 12px;
}

listview {
	background-color: transparent;
	columns: 6;
	lines: 3;
	spacing: 10px;
	fixed-height: false;
	cycle: true;
}

element {
	background-color: @glass-panel;
	border: 1px;
	border-color: transparent;
	border-radius: 16px;
	padding: 10px 6px;
	orientation: vertical;
}

element-icon {
	size: 42px;
	horizontal-align: 0.5;
}

/* Bright, high-contrast text against dark glass tiles - the
   original "darkest text" ask was for the old light/cream tiles;
   against this dark glass background the readable choice is the
   opposite direction, near-white rather than near-black. */
element-text {
	text-color: @text-main;
	horizontal-align: 0.5;
	padding: 6px 2px 0px 2px;
	font: "JetBrainsMono Nerd Font Bold 9";
}

element selected {
	background-color: @accent-soft;
	border-color: @glass-border;
}

element selected element-text {
	text-color: @text-main;
}
