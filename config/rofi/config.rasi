/*
 * Glassmorphism, translated from the exact web CSS recipe as closely
 * as rofi's rasi theme format allows. Two things from that recipe
 * don't carry over here:
 *   - backdrop-filter: blur() has no rasi equivalent - the actual
 *     blur-behind comes from Hyprland's layer rule on the "rofi"
 *     namespace instead.
 *   - box-shadow isn't a documented rasi property (unlike GTK CSS,
 *     which does support it) - skipped rather than assumed working.
 * background-color, border, and border-radius are used as given;
 * the top/left highlight lines are approximated with brighter
 * top/left border color, since rasi has no generated content.
 */

configuration {
	modi: "drun,run,filebrowser";
	show-icons: true;
	icon-theme: "Papirus-Dark";
	drun-display-format: "{name}";
	display-drun: " Applications";
	display-run: " Run";
	display-filebrowser: " Files";
	font: "JetBrainsMono Nerd Font 11";
}

* {
	glass-bg:        rgba(255, 255, 255, 0.08);
	glass-panel:     rgba(255, 255, 255, 0.4);
	glass-border:    rgba(255, 255, 255, 0.3);
	glass-highlight: rgba(255, 255, 255, 0.8);
	text-main:       #1a1a1a;
	text-dim:        #1a1a1a99;

	background-color: transparent;
	text-color: @text-main;
}

window {
	background-color: @glass-bg;
	border: 2px;
	border-color: @glass-highlight;
	border-radius: 24px;
	padding: 20px;
	width: 720px;
	location: center;
}

mainbox {
	background-color: transparent;
	spacing: 16px;
	children: [ "inputbar", "listview" ];
}

inputbar {
	background-color: @glass-panel;
	border: 1px;
	border-color: @glass-border;
	border-radius: 999px;
	padding: 10px 12px;
	spacing: 10px;
	children: [ "prompt", "entry" ];
}

prompt {
	background-color: transparent;
	text-color: @text-main;
	border-radius: 999px;
	padding: 6px 16px;
	font: "JetBrainsMono Nerd Font Bold 11";
}

entry {
	background-color: transparent;
	text-color: @text-main;
	placeholder: "Search...";
	placeholder-color: @text-dim;
	padding: 6px 12px;
}

listview {
	background-color: transparent;
	columns: 6;
	lines: 3;
	spacing: 10px;
	fixed-height: false;
	cycle: true;
}

element {
	background-color: @glass-panel;
	border: 2px;
	border-color: @glass-highlight;
	border-radius: 16px;
	padding: 10px 6px;
	orientation: vertical;
}

element-icon {
	background-color: transparent;
	size: 42px;
	horizontal-align: 0.5;
}

element-text {
	text-color: @text-main;
	horizontal-align: 0.5;
	padding: 6px 2px 0px 2px;
	font: "JetBrainsMono Nerd Font Bold 9";
}

element selected {
	background-color: rgba(255, 255, 255, 0.55);
	border-color: @glass-highlight;
}

element selected element-text {
	text-color: @text-main;
}
