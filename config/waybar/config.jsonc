[
  {
    "layer": "top",
    "position": "top",

    "height": 34,
    "spacing": 4,

    "margin-top": 2,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": [
      "custom/logo",
      "hyprland/workspaces"
    ],

    "modules-center": [
      "custom/music",
      "clock"
    ],

    "modules-right": [
      "cpu",
      "memory",
      "network",
      "custom/bluetooth",
      "custom/clipboard",
      "backlight",
      "pulseaudio",
      "battery",
      "custom/notifications"
    ],
 
    "custom/logo": {
      "format": "",
      "tooltip": "Power menu",
      "on-click": "wlogout --buttons-per-row 5",
      "on-click-right": "rofi -show drun -show-icons",
      "on-click-middle": "kitty"
    },

    "clock": {
      "format": "{:%a %d %b   %H:%M}",
      "tooltip-format": "{:%A, %d %B %Y}",
      "interval": 60,
      "on-click": "gsimplecal"
    },

    "cpu": {
      "format": "󰍛 {usage}%",
      "interval": 5,
      "on-click": "$HOME/.config/waybar/scripts/system-monitor.sh"
    },

    "custom/clipboard": {
      "exec": "$HOME/.config/waybar/scripts/clipboard.sh",
      "return-type": "json",
      "interval": 5,
      "signal": 8,
      "on-click": "$HOME/.config/waybar/scripts/clipboard-menu.sh",
      "on-click-right": "$HOME/.config/waybar/scripts/clipboard-clear.sh"
    },

    "memory": {
      "format": "󰘚 {percentage}%",
      "interval": 5,
      "on-click": "$HOME/.config/waybar/scripts/system-monitor.sh"
    },

    "network": {
      "format-wifi": "󰖩 {signalStrength}%",
      "format-ethernet": "󰈀",
      "format-disconnected": "󰖪",
      "on-click": "$HOME/.config/waybar/scripts/wifi-manager.sh"
    },

    "backlight": {
      "format": "{icon} {percent}%",
      "format-icons": ["󰃞", "󰃟", "󰃠"],
      "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
      "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
    },

    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-muted": "󰝟",
      "format-icons": [
        "",
        "",
        ""
      ],
      "on-click": "$HOME/.config/waybar/scripts/sound-manager.sh"
    },

    "custom/music": {
    "exec": "$HOME/.config/waybar/scripts/music.sh",
    "return-type": "json",
    "interval": 1,
      "on-click": "playerctl play-pause",
      "on-click-middle": "playerctl stop",
      "on-click-right": "spotify-launcher",
      "on-scroll-up": "playerctl next",
      "on-scroll-down": "playerctl previous",
      "escape": true
    },

    "battery": {
      "format": "{icon} {capacity}%",
      "format-icons": [
        "󰂎",
        "󰁺",
        "󰁼",
        "󰁾",
        "󰂀"
      ]
    },

    "custom/bluetooth": {
      "exec": "$HOME/.config/waybar/scripts/bluetooth.sh",
      "return-type": "json",
      "interval": 3,
      "on-click": "blueman-manager",
      "on-click-right": "kitty -e bluetoothctl"
    },

    "custom/notifications": {
      "exec": "$HOME/.config/waybar/scripts/notifications.sh",
      "return-type": "json",
      "interval": 2,
      "on-click": "swaync-client -t"
    },

    "tray": {
      "spacing": 8
    }
  }
]