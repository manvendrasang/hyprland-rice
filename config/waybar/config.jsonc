[
  {
    "layer": "top",
    "position": "top",

    "height": 34,
    "spacing": 4,

    "margin-top": 2,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": [
      "custom/logo",
      "hyprland/workspaces"
    ],

    "modules-center": [
      "custom/music",
      "clock"
    ],

    "modules-right": [
      "custom/gpu",
      "cpu",
      "memory",
      "temperature",
      "network",
      "custom/bluetooth",
      "custom/clipboard",
      "pulseaudio",
      "battery",
      "custom/notifications"
    ],
 
    "custom/logo": {
      "format": "",
      "tooltip": false,
      "on-click": "rofi -show drun -show-icons",
      "on-click-right": "rofi -show run",
      "on-click-middle": "kitty"
    },

    "custom/gpu": {
      "exec": "$HOME/.config/waybar/scripts/gpu.sh",
      "return-type": "json",
      "interval": 2,
      "on-click": "$HOME/.config/waybar/scripts/system-monitor.sh"
    },

    "clock": {
      "format": "{:%a %d %b   %H:%M}",
      "tooltip-format": "{:%A, %d %B %Y}",
      "interval": 60,
      "on-click": "rofi -show calendar"
    },

    "cpu": {
      "exec": "$HOME/.config/waybar/scripts/cpu.sh",
      "format": "󰍛 {}%",
      "interval": 2,
      "on-click": "$HOME/.config/waybar/scripts/system-monitor.sh"
    },

    "custom/clipboard": {
      "exec": "$HOME/.config/waybar/scripts/clipboard.sh",
      "return-type": "json",
      "interval": 5,
      "on-click": "$HOME/.config/waybar/scripts/clipboard-menu.sh",
      "on-click-right": "cliphist wipe"
    },

    "memory": {
      "exec": "$HOME/.config/waybar/scripts/memory.sh",
      "format": "󰘚 {}%",
      "interval": 2,
      "on-click": "$HOME/.config/waybar/scripts/system-monitor.sh"
    },

    "temperature": {
      "critical-threshold": 80,
      "format": "󰔄 {temperatureC}°",
      "on-click": "$HOME/.config/waybar/scripts/system-monitor.sh"
    },

    "network": {
      "format-wifi": "󰖩 {signalStrength}%",
      "format-ethernet": "󰈀",
      "format-disconnected": "󰖪",
      "on-click": "nm-connection-editor"
    },

    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-muted": "󰝟",
      "format-icons": [
        "",
        "",
        ""
      ],
      "on-click": "pavucontrol"
    },

    "custom/music": {
    "exec": "$HOME/.config/waybar/scripts/music.sh",
    "return-type": "json",
    "interval": 1,
      "on-click": "playerctl play-pause",
      "on-click-middle": "playerctl stop",
      "on-click-right": "spotify-launcher",
      "on-scroll-up": "playerctl next",
      "on-scroll-down": "playerctl previous",
      "escape": true
    },

    "battery": {
      "format": "{icon} {capacity}%",
      "format-icons": [
        "󰂎",
        "󰁺",
        "󰁼",
        "󰁾",
        "󰂀"
      ]
    },

    "custom/bluetooth": {
      "exec": "$HOME/.config/waybar/scripts/bluetooth.sh",
      "return-type": "json",
      "interval": 3,
      "on-click": "blueman-manager",
      "on-click-right": "kitty -e bluetoothctl"
    },

    "custom/notifications": {
      "exec": "$HOME/.config/waybar/scripts/notifications.sh",
      "return-type": "json",
      "interval": 2,
      "on-click": "swaync-client -t"
    },

    "tray": {
      "spacing": 8
    }
  }
]