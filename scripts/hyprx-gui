#!/usr/bin/env bash
# Launch the HyprX GUI.
#
# Interpreter selection is not optional here: pyenv shims come first on PATH
# on this machine, so a bare `python3` resolves to the pyenv build, which has
# no PySide6 - the same shadowing that made `makepkg` fail with "No module
# named build" for waypaper. So try each candidate and use the first one that
# can actually import the toolkit, rather than trusting PATH order.

set -uo pipefail

# The repo root is two levels up: this file is <root>/scripts/hyprx-gui.
# One dirname short of that, and `python -m gui` runs from scripts/ - which has
# no gui package, so the launcher failed with "No module named gui".
ROOT_DIR="$(cd "$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")" && pwd)"

PYTHON_BIN=""
for candidate in \
    ${HYPRX_GUI_PYTHON:-} \
    /usr/bin/python3 \
    python3 \
    python; do
    [[ -n "$candidate" ]] || continue
    command -v "$candidate" >/dev/null 2>&1 || continue
    if "$candidate" -c 'import PySide6' >/dev/null 2>&1; then
        PYTHON_BIN="$candidate"
        break
    fi
done

if [[ -z "$PYTHON_BIN" ]]; then
    echo "hyprx-gui: no Python interpreter with PySide6 found." >&2
    echo "" >&2
    echo "  Install it:  sudo pacman -S pyside6" >&2
    echo "  If you use pyenv, its shims shadow /usr/bin/python3 - that is fine," >&2
    echo "  this launcher prefers the system interpreter." >&2
    echo "" >&2
    echo "  Override with:  HYPRX_GUI_PYTHON=/path/to/python hyprx-gui" >&2
    exit 1
fi

# QT is unhappy about running as root and about the xcb platform plugin on
# some setups; keep the platform override opt-in via the environment rather
# than forcing it here.
cd "$ROOT_DIR" || exit 1
exec "$PYTHON_BIN" -m gui "$@"