#!/usr/bin/env bash

# No `set -e` on purpose: it would abort the moment any command file returns
# non-zero internally, and commands legitimately probe things that can fail
# (cached sudo ticket? a tty?) and must report and carry on. Each command owns
# its error handling and returns an explicit exit code.
set -uo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

export ROOT_DIR

source "$ROOT_DIR/lib/bootstrap.sh"

# Global frontend flags, extracted before dispatch so no per-command parser
# needs to learn them. Only exact matches are pulled - anything else passes
# through untouched, so a positional value that happens to start with `--`
# (a wallpaper path can) is never eaten.
HYPRX_CLI_ARGS=()
for arg in "$@"; do
    case "$arg" in
        --events) export HYPRX_EVENTS=1 ;;
        --password-stdin) export HYPRX_PASSWORD_STDIN=1 ;;
        *) HYPRX_CLI_ARGS+=("$arg") ;;
    esac
done
set -- "${HYPRX_CLI_ARGS[@]}"

COMMAND="${1:-help}"
shift || true

# COMMAND is used to build a path that is then sourced, so an unvalidated value
# turns the dispatcher into an arbitrary-file-inclusion primitive:
#
#   $ hyprx ../../../../tmp/evil     ->  sourced /tmp/evil.sh and ran it
#
# lib/installer/deploy.sh goes to real trouble to reject `../escape`, `a/b`, `.`
# and `..` as config directory names; the entry point that runs before any of
# that validated nothing at all. Both checks stay - the path check here guards
# dispatch, the one in deploy.sh guards the data.
#
# The whitelist is the list of files that actually exist in commands/, so adding
# a command needs no edit here.
if [[ ! "$COMMAND" =~ ^[a-z][a-z0-9_-]*$ ]]; then
    hyprx_ui_error "Invalid command name: $COMMAND"
    hyprx_ui_info "Command names are lowercase letters, digits, - and _."
    exit 1
fi

COMMAND_FILE="$HYPRX_COMMANDS/$COMMAND.sh"

if [[ ! -f "$COMMAND_FILE" ]]; then
    hyprx_ui_error "Unknown command: $COMMAND"
    echo
    hyprx_ui_info "Available commands:"
    find "$HYPRX_COMMANDS" -maxdepth 1 -type f -name "*.sh" \
        -printf "%f\n" | sed 's/\.sh$//' | sort
    exit 1
fi

# One EXIT trap for the whole process, running registered hooks in order.
# Commands exit from anywhere (`exit N` inside a sourced command file ends the
# process on the spot), so completion and cleanup cannot live in straight-line
# code after `source` - they would never run on an early exit. Every hook
# guards BASH_SUBSHELL itself (see lib/lock.sh) and must be idempotent.
HYPRX_EXIT_HOOKS=()
HYPRX_RUN_STARTED=""
HYPRX_COMMAND_RC=0
hyprx_on_exit() { HYPRX_EXIT_HOOKS+=("$1"); }
hyprx_exit_trap() {
    # Capture FIRST: even the subshell guard below would clobber $? with its
    # own status, and then every failure would complete as rc=0 - the exact
    # lie the Phase-2 red visuals must never be told.
    local rc=$?
    (( BASH_SUBSHELL == 0 )) || return 0
    HYPRX_COMMAND_RC=$rc
    local hook
    for hook in ${HYPRX_EXIT_HOOKS[@]+"${HYPRX_EXIT_HOOKS[@]}"}; do
        "$hook" || true
    done
}
trap hyprx_exit_trap EXIT

# run.completed for the dispatched command. Only fires when run.started did -
# usage errors before dispatch have no start event to complete.
hyprx_dispatch_completed() {
    [[ -n "$HYPRX_RUN_STARTED" ]] || return 0
    hyprx_event run.completed command="$COMMAND" rc="$HYPRX_COMMAND_RC"
}
hyprx_on_exit hyprx_elevate_cleanup
hyprx_on_exit hyprx_dispatch_completed

# A GUI has no TTY for sudo to prompt on, so it pipes the password instead.
# Validated (and the refresher started) before dispatch, so the gate's
# `sudo -n true` probe passes on the cached ticket with no code change there.
if [[ "${HYPRX_PASSWORD_STDIN:-0}" == "1" ]]; then
    hyprx_elevate_password_stdin || exit 1
fi

hyprx_event run.started command="$COMMAND"
HYPRX_RUN_STARTED=1

source "$COMMAND_FILE"
# No straight-line code after this point runs on an `exit` inside the command
# file - completion (run.completed) and cleanup (sudo refresher, lock) are
# owned by the EXIT trap above. See hyprx_exit_trap.
